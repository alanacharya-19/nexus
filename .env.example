# ---------------------------------------------------------------------------
# NEXUS API
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL. Use a local database or the Supabase connection string.
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus
# Set to require TLS (Supabase requires this in production).
DATABASE_SSL=false

# Secret used to encrypt provider credentials at rest (min 32 chars).
# Generate with: openssl rand -base64 48
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-long-random-value-at-least-32-chars

# Local development auth. Disable in production.
ALLOW_DEV_AUTH=true
DEV_JWT_SECRET=change-me-dev-jwt-secret-at-least-32-characters
# Comma-separated list of emails allowed to use dev auth (optional).
DEV_AUTH_ALLOWLIST=

# Supabase auth (optional; required for Supabase sign-in)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Either a legacy JWT secret (HS256) or leave blank to use JWKS verification.
SUPABASE_JWT_SECRET=

# Server-side provider keys (optional). Users can also store their own keys,
# which take precedence and are encrypted with CREDENTIAL_ENCRYPTION_KEY.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Orchestration limits
MAX_CONCURRENT_RUNS=3
PROVIDER_TIMEOUT_MS=120000
PROVIDER_MAX_RETRIES=2

# Comma-separated origins allowed to call the API. * is fine for local dev.
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# NEXUS Mobile (apps/mobile/.env)
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL=http://localhost:4000
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
